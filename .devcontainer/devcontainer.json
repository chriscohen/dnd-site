{
    "name": "D&D Site",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },

    "forwardPorts": [8080, 3000, 3306],

    "portsAttributes": {
        "8080": { "label":  "Laravel API", "onAutoForward": "notify" },
        "3000": { "label":  "Nuxt Frontend", "onAutoForward": "notify" },
        "3306": { "label":  "MySQL", "onAutoForward": "silent" }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "Vue.volar",
                "bradlc.vscode-tailwindcss"
            ]
        }
    },

    "remoteUser": "vscode"
}
