{
    "containers": {
        "nginx": {
            "image": ":dnd-service.nginx.1",
            "ports": {
                "80": "HTTP"
            }
        },
        "laravel": {
            "image": ":dnd-service.laravel.1",
            "ports": {
                "9000": "TCP"
            }
        },
        "nuxt": {
            "image": ":dnd-service.nuxt.1",
            "ports": {
                "3000": "HTTP"
            }
        }
    },
    "publicEndpoint": {
        "containerName": "nginx",
        "containerPort": "80",
        "healthCheck": {
            "path": "/",
            "successCodes": "200-399"
        }
    }
}
